# Production Environment Variables Template
# Copy to .env.production and fill in actual values
# DO NOT commit .env.production with real values

# ============================================
# Frontend Configuration
# ============================================

# API URL - Set to your Railway backend URL
VITE_API_URL=https://your-railway-backend-url.up.railway.app

# Clerk Configuration - Use Production Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key_here

# Gemini API Key
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Sentry (Optional - for error tracking)
# VITE_SENTRY_DSN=https://xxxxxx@xxxx.ingest.sentry.io/xxxxx
