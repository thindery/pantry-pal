{
  "name": "pantry-pal",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev -w @pantry-pal/frontend",
    "dev:backend": ".venv/bin/python -m uvicorn app:app --reload --host 0.0.0.0 --port 8000",
    "build": "npm run build:frontend",
    "build:frontend": "npm run build -w @pantry-pal/frontend",
    "start": ".venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8000",
    "typecheck": "npm run typecheck -w @pantry-pal/frontend",
    "lint": "npm run lint -w @pantry-pal/frontend",
    "lint:fix": "npm run lint:fix -w @pantry-pal/frontend",
    "test": "npm run test:run -w @pantry-pal/frontend",
    "test:run": "npm run test:run -w @pantry-pal/frontend",
    "test:backend": "ALLOW_TEST_AUTH=1 .venv/bin/python -m pytest tests/ -v --ignore=tests/test_postgres_integration.py",
    "test:postgres": "RUN_POSTGRES_TESTS=1 .venv/bin/python -m pytest tests/test_postgres_integration.py -v",
    "test:sql-safety": ".venv/bin/python -m pytest tests/test_sql_upsert_safety.py -v",
    "migrate": ".venv/bin/python database/migrate.py migrate",
    "migrate:status": ".venv/bin/python database/migrate.py status",
    "openapi:export": ".venv/bin/python scripts/export_openapi.py",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run test:backend",
    "check:ci": "npm run check && npm run build:frontend",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.1.7"
  }
}