# ============================================================
# PantryPal — environment template
# ============================================================
# cp .env.example .env.dev && ./switch-env.sh dev

# ------------------------------------------------------------
# FRONTEND (Next.js)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

NEXT_PUBLIC_BUILD_ID=dev

# ------------------------------------------------------------
# BACKEND (FastAPI)
# ------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,https://localhost:3000
ENABLE_API_DOCS=1

# Admin access (comma-separated emails)
ADMIN_EMAILS=you@example.com

# Database (Postgres-first)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pantry_pal
POSTGRES_USER=pantry_pal_user
POSTGRES_PASSWORD=secure_password_placeholder
POSTGRES_DB=pantry_pal_prod

# Auth is NextAuth (AUTH_SECRET / Google OAuth). Clerk is legacy and unused in production.
# CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY

# Rate limiting: leave TRUST_PROXY unset locally so clients cannot spoof CF/XFF headers.
# TRUST_PROXY=1

# Stripe
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PRO_MONTHLY_PRICE_ID=price_test_pro_monthly
STRIPE_PRO_YEARLY_PRICE_ID=price_test_pro_yearly
STRIPE_FAMILY_MONTHLY_PRICE_ID=price_test_family_monthly
STRIPE_FAMILY_YEARLY_PRICE_ID=price_test_family_yearly
# PP-166 optional: Stripe coupon id for the $1 first month on Pro monthly. Leave blank to keep the offer off.
STRIPE_PRO_FIRST_MONTH_COUPON_ID=

# Feature limits
# PP-186 Receipt AI (server env only; never VITE_/NEXT_PUBLIC_). Off unless AI_RECEIPT_SCAN_ENABLED=1.
# Provider order: the one chosen in Admin > Feature Flags (default Ollama), then the other, then pytesseract.
AI_RECEIPT_SCAN_ENABLED=0
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_RECEIPT_MODEL=gemma4:cloud
GEMINI_API_KEY=
GEMINI_RECEIPT_MODEL=gemini-3.1-flash-lite
AI_PROVIDER_TIMEOUT_SECONDS=25
AI_CAP_COOLDOWN_SECONDS=600
AI_RECEIPT_MAX_IMAGE_BYTES=6291456

# PP-183 AI recipe builder (server env only). Off unless AI_FEATURES_ENABLED=1.
# Caps are checked before every provider call (fallback included); 0 blocks everything.
AI_FEATURES_ENABLED=0
AI_USER_WEEKLY_TOKENS=50000
AI_GLOBAL_WEEKLY_TOKENS=300000
AI_USER_HOURLY_REQUESTS=10
# Global weekly window start (UTC), align with the provider's weekly reset. 0=Monday.
AI_WEEK_RESET_DOW=0
AI_WEEK_RESET_HOUR_UTC=0
AI_AUTO_TRIP_RATIO=0.9
AI_CACHE_TTL_HOURS=24
# Optional; default to the receipt models above.
OLLAMA_TEXT_MODEL=
GEMINI_TEXT_MODEL=

FREE_TIER_RECEIPT_SCANS=10
FREE_TIER_AI_CALLS=50
FREE_TIER_VOICE_SESSIONS=5
PRO_TIER_RECEIPT_SCANS=100
PRO_TIER_AI_CALLS=500
PRO_TIER_VOICE_SESSIONS=50

# Deploy
BUILD_ID=unknown
# Production: https://www.mypantryhub.com (see .env.prod.example)
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Test helpers (never enable in production)
ALLOW_TEST_AUTH=0

# Resend transactional email (PP-096). Leave unset to no-op sends (logged in production).
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=Pantry Hub <noreply@mypantryhub.com>
# Resend webhook signing secret (whsec_..., from the Resend dashboard webhook).
RESEND_WEBHOOK_SECRET=whsec_YOUR_RESEND_WEBHOOK_SECRET

# PP-137: weekly opt-in low-stock email. Blank/0 = off (toggle hidden, cron no-ops).
LOW_STOCK_DIGEST_ENABLED=

# PP-194: email journeys (double opt-in, welcome, onboarding). ALL OFF by default; nothing non-transactional is sent.
# Comma list of addresses that may receive journey mail while EMAIL_JOURNEYS_ENABLED is off (test mode).
EMAIL_JOURNEYS_TEST_RECIPIENTS=
# Set to true ONLY after Tylor approves the copy. Needs EMAIL_MAILING_ADDRESS for commercial mail (CAN-SPAM).
EMAIL_JOURNEYS_ENABLED=
EMAIL_MAILING_ADDRESS=
# Only app accounts created at/after this ISO timestamp are enrolled in onboarding. Blank = nobody.
EMAIL_ONBOARDING_SINCE=

# PP-129: optional separate Resend key for read-only dashboard cross-checks. Never used to send.
RESEND_READ_API_KEY=
