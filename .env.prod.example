# Production template — copy to .env.prod and fill secrets (never commit .env.prod)
# ./switch-env.sh prod

# ------------------------------------------------------------
# OVH container ports (app-network only — not published on host)
# ------------------------------------------------------------
FRONTEND_PORT=38472
BACKEND_PORT=52841

# ------------------------------------------------------------
# AUTH (NextAuth v5 + Google OAuth)
# ------------------------------------------------------------
AUTH_SECRET=GENERATE_WITH_openssl_rand_-base64_32
AUTH_URL=https://www.mypantryhub.com
AUTH_GOOGLE_ID=5468519944-85hv200audnjrugf4e300bo97c3fd32f.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=YOUR_GOOGLE_CLIENT_SECRET
ADMIN_EMAILS=thindery@gmail.com

# ------------------------------------------------------------
# FRONTEND (Next.js)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://pantry-pal-backend:52841
NEXT_PUBLIC_SITE_URL=https://www.mypantryhub.com
AUTH_URL=https://www.mypantryhub.com
FRONTEND_URL=https://www.mypantryhub.com
NEXT_PUBLIC_BUILD_ID=unknown

# ------------------------------------------------------------
# BACKEND (FastAPI)
# ------------------------------------------------------------
PORT=52841
ENVIRONMENT=production
CORS_ORIGINS=https://mypantryhub.com,https://www.mypantryhub.com
ENABLE_API_DOCS=0

DATABASE_URL=postgresql://pantry_pal_user:CHANGE_ME@pantry-pal-db/pantry_pal_prod
POSTGRES_USER=pantry_pal_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pantry_pal_prod

STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PRO_MONTHLY_PRICE_ID=price_live_pro_monthly
STRIPE_PRO_YEARLY_PRICE_ID=price_live_pro_yearly
STRIPE_FAMILY_MONTHLY_PRICE_ID=price_live_family_monthly
STRIPE_FAMILY_YEARLY_PRICE_ID=price_live_family_yearly
# PP-166 optional: Stripe coupon id for the $1 first month on Pro monthly. Leave blank to keep the offer off.
STRIPE_PRO_FIRST_MONTH_COUPON_ID=
# PP-247: optional Customer Portal configuration id (bpc_...) that allows Pro monthly <-> yearly switching. Blank = Stripe default portal.
STRIPE_PORTAL_CONFIGURATION_ID=

# PP-178 Send to Instacart (Beta). Server env only. Unset = button hidden, endpoint 404.
# Dev base is the default; production base is https://connect.instacart.com
INSTACART_API_KEY=
INSTACART_API_BASE=https://connect.dev.instacart.tools

# PP-186 Receipt AI (server env only; never VITE_/NEXT_PUBLIC_). Off unless AI_RECEIPT_SCAN_ENABLED=1.
# Provider order: the one chosen in Admin > Feature Flags (default Ollama), then the other, then pytesseract.
AI_RECEIPT_SCAN_ENABLED=0
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_RECEIPT_MODEL=gemma4:cloud
GEMINI_API_KEY=
GEMINI_RECEIPT_MODEL=gemini-3.1-flash-lite
AI_PROVIDER_TIMEOUT_SECONDS=25
AI_CAP_COOLDOWN_SECONDS=600
AI_RECEIPT_MAX_IMAGE_BYTES=6291456

# PP-183 AI recipe builder (server env only). Off unless AI_FEATURES_ENABLED=1.
# Caps are checked before every provider call (fallback included); 0 blocks everything.
AI_FEATURES_ENABLED=0
AI_USER_WEEKLY_TOKENS=50000
AI_GLOBAL_WEEKLY_TOKENS=300000
AI_USER_HOURLY_REQUESTS=10
# Global weekly window start (UTC), align with the provider's weekly reset. 0=Monday.
AI_WEEK_RESET_DOW=0
AI_WEEK_RESET_HOUR_UTC=0
AI_AUTO_TRIP_RATIO=0.9
AI_CACHE_TTL_HOURS=24
# Optional; default to the receipt models above.
OLLAMA_TEXT_MODEL=
GEMINI_TEXT_MODEL=

FREE_TIER_RECEIPT_SCANS=10
FREE_TIER_AI_CALLS=50
FREE_TIER_VOICE_SESSIONS=5
PRO_TIER_RECEIPT_SCANS=100
PRO_TIER_AI_CALLS=500
PRO_TIER_VOICE_SESSIONS=50

BUILD_ID=unknown
FRONTEND_URL=https://www.mypantryhub.com
APP_URL=https://www.mypantryhub.com

ALLOW_TEST_AUTH=0

# Barcode product cache TTL (days) — Open Food Facts lookups are cached in Postgres
PRODUCT_CACHE_MAX_AGE_DAYS=60

# Rate limiting (PP-052) — postgres store survives restarts; memory for local dev only
RATE_LIMIT_STORE=postgres
JWT_AUDIENCE=pantry-pal

# Trust CF-Connecting-IP / X-Forwarded-For for unauth rate-limit keys (PP-071)
# Only enable behind Cloudflare + central nginx (never on public direct exposure).
TRUST_PROXY=1

# Resend transactional email (PP-096). Leave unset to no-op sends (logged in production).
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=Pantry Hub <noreply@mypantryhub.com>
# Resend webhook signing secret (whsec_..., from the Resend dashboard webhook).
RESEND_WEBHOOK_SECRET=whsec_YOUR_RESEND_WEBHOOK_SECRET

# PP-137: weekly opt-in low-stock email. Blank/0 = off (toggle hidden, cron no-ops).
LOW_STOCK_DIGEST_ENABLED=

# PP-194: email journeys (double opt-in, welcome, onboarding). ALL OFF by default; nothing non-transactional is sent.
# Comma list of addresses that may receive journey mail while EMAIL_JOURNEYS_ENABLED is off (test mode).
EMAIL_JOURNEYS_TEST_RECIPIENTS=
# Set to true ONLY after Tylor approves the copy. Needs EMAIL_MAILING_ADDRESS for commercial mail (CAN-SPAM).
EMAIL_JOURNEYS_ENABLED=
EMAIL_MAILING_ADDRESS=
# Only app accounts created at/after this ISO timestamp are enrolled in onboarding. Blank = nobody.
EMAIL_ONBOARDING_SINCE=
# PP-235 weekly recipe email. The weekly job only emails a [TEST] copy to this address until an admin approves the issue.
EMAIL_WEEKLY_TEST_TO=
# Leave blank/false. When true, a draft approves itself EMAIL_WEEKLY_AUTO_SEND_DELAY_HOURS (default 24) after its test copy unless an admin skips it.
EMAIL_WEEKLY_AUTO_SEND=
EMAIL_WEEKLY_AUTO_SEND_DELAY_HOURS=

# PP-129: optional separate Resend key for read-only dashboard cross-checks. Never used to send.
RESEND_READ_API_KEY=
