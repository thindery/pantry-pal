# Production template — copy to .env.prod and fill secrets (never commit .env.prod)
# ./switch-env.sh prod

# ------------------------------------------------------------
# OVH container ports (app-network only — not published on host)
# ------------------------------------------------------------
FRONTEND_PORT=38472
BACKEND_PORT=52841

# ------------------------------------------------------------
# AUTH (NextAuth v5 + Google OAuth)
# ------------------------------------------------------------
AUTH_SECRET=GENERATE_WITH_openssl_rand_-base64_32
AUTH_URL=https://www.mypantryhub.com
AUTH_GOOGLE_ID=5468519944-85hv200audnjrugf4e300bo97c3fd32f.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=YOUR_GOOGLE_CLIENT_SECRET
ADMIN_EMAILS=thindery@gmail.com
NEXT_PUBLIC_ADMIN_EMAILS=thindery@gmail.com

# ------------------------------------------------------------
# FRONTEND (Next.js)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://pantry-pal-backend:52841
NEXT_PUBLIC_SITE_URL=https://www.mypantryhub.com
NEXT_PUBLIC_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
NEXT_PUBLIC_BUILD_ID=unknown

# ------------------------------------------------------------
# BACKEND (FastAPI)
# ------------------------------------------------------------
PORT=52841
ENVIRONMENT=production
CORS_ORIGINS=https://mypantryhub.com,https://www.mypantryhub.com
ENABLE_API_DOCS=0

DATABASE_URL=postgresql://pantry_pal_user:CHANGE_ME@pantry-pal-db/pantry_pal_prod
POSTGRES_USER=pantry_pal_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pantry_pal_prod

STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PRO_MONTHLY_PRICE_ID=price_live_pro_monthly
STRIPE_PRO_YEARLY_PRICE_ID=price_live_pro_yearly
STRIPE_FAMILY_MONTHLY_PRICE_ID=price_live_family_monthly
STRIPE_FAMILY_YEARLY_PRICE_ID=price_live_family_yearly

FREE_TIER_RECEIPT_SCANS=10
FREE_TIER_AI_CALLS=50
FREE_TIER_VOICE_SESSIONS=5
PRO_TIER_RECEIPT_SCANS=100
PRO_TIER_AI_CALLS=500
PRO_TIER_VOICE_SESSIONS=50

BUILD_ID=unknown
FRONTEND_URL=https://www.mypantryhub.com
APP_URL=https://www.mypantryhub.com

ALLOW_TEST_AUTH=0