# NextAuth (Google OAuth)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres — NextAuth adapter (local dev: same DB as backend)
DATABASE_URL=postgresql://pantry_pal_user:password@localhost:5432/pantry_pal_dev

# Admin access (comma-separated emails)
ADMIN_EMAILS=you@example.com
NEXT_PUBLIC_ADMIN_EMAILS=you@example.com

# API — proxied via next.config rewrites; use backend service URL in Docker
NEXT_PUBLIC_API_URL=http://localhost:8000



# Optional: Sentry
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENVIRONMENT=development

# Build/deploy
NEXT_PUBLIC_BUILD_ID=dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000